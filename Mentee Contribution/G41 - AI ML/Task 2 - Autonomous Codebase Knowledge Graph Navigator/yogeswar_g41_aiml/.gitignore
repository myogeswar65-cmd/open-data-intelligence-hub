# Environment variables and local configs
.env
.env.*
!.env.example

# Secrets, private keys, certificates, passwords
secrets/
*.pem
*.key
*.password
*.pwd
nginx/certs/*.key

# Local databases and storage
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

