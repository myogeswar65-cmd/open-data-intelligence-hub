git_storage/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/

# Node / Frontend build output & dependencies
frontend/node_modules/
frontend/dist/
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System files
.DS_Store
Thumbs.db
